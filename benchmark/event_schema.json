{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/vda5050-benchmark-event.schema.json",
  "title": "VDA 5050 native comparison benchmark event",
  "type": "object",
  "required": [
    "schema_version",
    "timestamp_utc",
    "monotonic_ns",
    "trial_id",
    "pair_id",
    "architecture",
    "device",
    "operation",
    "command_id",
    "order_id",
    "event_type",
    "result",
    "success",
    "git_commit",
    "config_id",
    "source",
    "host",
    "boot_id",
    "pid"
  ],
  "properties": {
    "schema_version": {
      "const": "3.0"
    },
    "timestamp_utc": {
      "type": "string",
      "format": "date-time"
    },
    "monotonic_ns": {
      "type": "integer",
      "minimum": 0
    },
    "trial_id": {
      "type": "string",
      "minLength": 1
    },
    "pair_id": {
      "type": "string"
    },
    "architecture": {
      "enum": [
        "native",
        "vda",
        "setup"
      ]
    },
    "device": {
      "enum": [
        "rox", "crane"
      ]
    },
    "operation": {
      "type": "string",
      "minLength": 1
    },
    "command_id": {
      "type": "string",
      "minLength": 1
    },
    "order_id": {
      "type": "string"
    },
    "event_type": {
      "enum": [
        "COMMAND_ISSUED",
        "COMMAND_ACK_RECEIVED",
        "COMMAND_RESULT_RECEIVED",
        "TRIAL_FINISHED"
      ]
    },
    "result": {
      "type": "string"
    },
    "success": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "git_commit": {
      "type": "string"
    },
    "config_id": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "host": {
      "type": "string"
    },
    "boot_id": {
      "type": "string"
    },
    "pid": {
      "type": "integer"
    },
    "details": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
