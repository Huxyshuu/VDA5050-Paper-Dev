[Unit]
Description=ROX-Diff VDA 5050 adapter (dry-run commissioning)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=neobotix
Environment=ROS_DISTRO=jazzy
Environment=NEOBOTIX_WS=/home/neobotix/ros2_workspace
Environment=RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
Environment=ROS_DOMAIN_ID=0
Environment=VDA_MQTT_HOST=192.168.50.115
Environment=VDA_MAP_ID=df_map
WorkingDirectory=/home/neobotix/Projects/VDA5050-Paper-Dev
ExecStart=/home/neobotix/Projects/VDA5050-Paper-Dev/scripts/run_rox_adapter_dry.sh
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
