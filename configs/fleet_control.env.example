# Raspberry Pi master control / MQTT broker
VDA_MQTT_HOST=192.168.50.115
VDA_MQTT_PORT=1883
VDA_SCHEMA_DIR=schemas/vda5050_v3
VDA_PROTOCOL_VERSION=3.0.0
VDA_INTERFACE_NAME=vda5050
VDA_MAJOR_VERSION=v3
VDA_DEFAULT_MAP_ID=df_map

# Crane participant
CRANE_TOPIC_ROOT=vda5050/v3/konecranes/ilmatar_1
CRANE_MANUFACTURER=konecranes
CRANE_SERIAL=ilmatar_1
CRANE_VERSION=3.0.0
CRANE_ORDER_JSON_PATH=examples/orders/order_ilmatar_v3.json

# Neobotix ROX-Diff participant
ROX_TOPIC_ROOT=vda5050/v3/neobotix/rox_diff_1
ROX_MANUFACTURER=neobotix
ROX_SERIAL=rox_diff_1
ROX_VERSION=3.0.0
ROX_ORDER_JSON_PATH=examples/orders/order_rox_diff_v3.json

# Logical handover IDs must match both orders.
CRANE_HANDOVER_NODE_ID=node2
ROX_HANDOVER_NODE_ID=node2
HANDOVER_TAG=DROP_1
CRANE_AUTO_RELEASE_ACTION_ID=action4
CRANE_MANUAL_RELEASE_ACTION_ID=action6
CRANE_SAFE_LIFT_ACTION_ID=action7
ROX_HOLD_ACTION_ID=rox_hold_at_crane
MANUAL_RELEASE_TTL_S=180

# Generated from the first verified ROX waypoint.
ROX_INIT_X=
ROX_INIT_Y=
ROX_INIT_THETA=
ROX_INIT_MAP_ID=df_map
ROX_INIT_LAST_NODE_ID=
ROX_INIT_LAST_NODE_SEQUENCE_ID=0
