# Raspberry Pi master control / MQTT broker
VDA_MQTT_HOST=192.168.50.115
VDA_MQTT_PORT=1883
VDA_SCHEMA_DIR=schemas/vda5050_v3
VDA_PROTOCOL_VERSION=3.0.0
VDA_INTERFACE_NAME=vda5050
VDA_MAJOR_VERSION=v3
VDA_DEFAULT_MAP_ID=df_map

# Crane participant
CRANE_TOPIC_ROOT=vda5050/v3/konecranes/ilmatar_1
CRANE_MANUFACTURER=konecranes
CRANE_SERIAL=ilmatar_1
CRANE_VERSION=3.0.0
CRANE_ORDER_JSON_PATH=examples/orders/order_ilmatar_v3.json

# Neobotix ROX-Diff participant
ROX_TOPIC_ROOT=vda5050/v3/neobotix/rox_diff_1
ROX_MANUFACTURER=neobotix
ROX_SERIAL=rox_diff_1
ROX_VERSION=3.0.0
ROX_ORDER_JSON_PATH=examples/orders/order_rox_diff_v3.json

# Logical handover IDs must match both orders.
CRANE_HANDOVER_NODE_ID=node2
ROX_HANDOVER_NODE_ID=node2
HANDOVER_TAG=DROP_1
CRANE_AUTO_RELEASE_ACTION_ID=action4
CRANE_MANUAL_RELEASE_ACTION_ID=action6
CRANE_SAFE_LIFT_ACTION_ID=action7
ROX_HOLD_ACTION_ID=rox_hold_at_crane
MANUAL_RELEASE_TTL_S=180

# Generated from the first verified ROX waypoint.
ROX_INIT_X=0.1729
ROX_INIT_Y=0.015
ROX_INIT_THETA=-0.0073
ROX_INIT_MAP_ID=df_map
ROX_INIT_LAST_NODE_ID=node1
ROX_INIT_LAST_NODE_SEQUENCE_ID=0

# Flask mission-control dashboard
ROX_ENABLED=true
CRANE_ENABLED=true
ROX_WAYPOINT_FILE=configs/rox_waypoints.yaml
FLEET_UI_SCENARIO_FILE=configs/dashboard_scenarios.yaml
FLEET_UI_REQUIRE_LOCALIZED=true
FLEET_UI_REQUIRE_CONFIGURED_WAYPOINTS=true
FLEET_UI_START_TOLERANCE_M=0.35
FLEET_UI_STATE_STALE_S=35.0
FLEET_UI_ORDER_ACCEPT_TIMEOUT_S=12.0
FLEET_UI_EVENT_LIMIT=300
FLEET_UI_MISSION_LIMIT=50

# FLASK_HMI_V2_BEGIN
# Live map and research experiment logging.
FLEET_UI_MAP_YAML=configs/maps/df_map.yaml
FLEET_UI_EXPERIMENT_DB=results/experiments/mission_control.sqlite3
FLEET_UI_EXPERIMENT_DEFAULT=false
FLEET_UI_EXPERIMENT_SAMPLE_DISTANCE_M=0.01
# FLASK_HMI_V2_END
CRANE_MAP_ID=map
CRANE_WAYPOINT_FILE=configs/crane_waypoints.yaml
BUTTON_STATUS_URL=http://127.0.0.1:5000/status
CRANE_HOME_BRIDGE_M=17.534
CRANE_HOME_TROLLEY_M=6.664
CRANE_HOME_HOIST_M=3.071
CRANE_AUTO_WAIT_TIMEOUT_S=60
CRANE_AUTO_STABLE_S=1.0
CRANE_AUTO_MODE_POLL_S=0.20
CRANE_HOME_ON_START=false
CRANE_ALLOW_UNVERIFIED_MANUAL=false
CRANE_MQTT_CONNECT_TIMEOUT_S=15
