# Copy to configs/rox_waypoints.yaml after creating the ROX-Diff map.
# Set configured: true only after all poses were captured in the SAME map frame,
# verified in RViz, and successfully reached with ordinary Nav2 goals.
map_id: warehouse_case_study
configured: false
waypoints:
  home:
    x: 0.0
    y: 0.0
    theta: 0.0
    allowed_deviation_xy: 0.20
    allowed_deviation_theta: 0.20
  short_test:
    x: 0.0
    y: 0.0
    theta: 0.0
    allowed_deviation_xy: 0.20
    allowed_deviation_theta: 0.20
  crane_handover:
    x: 0.0
    y: 0.0
    theta: 0.0
    # Start conservatively. Tighten only after repeatability measurements.
    allowed_deviation_xy: 0.12
    allowed_deviation_theta: 0.15
  warehouse_dropoff:
    x: 0.0
    y: 0.0
    theta: 0.0
    allowed_deviation_xy: 0.20
    allowed_deviation_theta: 0.20
