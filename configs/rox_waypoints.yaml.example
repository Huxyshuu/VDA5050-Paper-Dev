# Copy to configs/rox_waypoints.yaml only when creating a new waypoint set.
# Set configured: true only after every pose is captured on the same map and
# repeatedly verified with ordinary Nav2 goals and physical clearance checks.
map_id: df_map
configured: false
waypoints:
  home:
    x: 0.0
    y: 0.0
    theta: 0.0
    allowed_deviation_xy: 0.20
    allowed_deviation_theta: 0.20
  short_test:
    x: 0.0
    y: 0.0
    theta: 0.0
    allowed_deviation_xy: 0.20
    allowed_deviation_theta: 0.20
  crane_handover:
    x: 0.0
    y: 0.0
    theta: 0.0
    allowed_deviation_xy: 0.12
    allowed_deviation_theta: 0.15
  warehouse_dropoff:
    x: 0.0
    y: 0.0
    theta: 0.0
    allowed_deviation_xy: 0.20
    allowed_deviation_theta: 0.20
